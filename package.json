{
  "name": "htmg",
  "version": "1.0.0",
  "private": true,
  "allowScripts": [
    "mime",
    "uuid"
  ],
  "scripts": {
    "build:backend": "cd hms-backend && npm ci --ignore-scripts && npm run build",
    "build:frontend": "cd hms-frontend && npm ci --ignore-scripts && npm run build",
    "build:all": "npm run build:backend && npm run build:frontend",
    "seed": "cd hms-backend && npx tsx src/db/seed.ts",
    "seed:neon": "cd hms-backend && npx tsx src/db/seed-neon.ts",
    "migrate": "cd hms-backend && npx tsx src/db/migrate-neon.ts",
    "setup:neon": "cd hms-backend && npx tsx src/db/migrate-neon.ts && npx tsx src/db/seed-neon.ts",
    "vercel:build": "npm run build:all"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "neonctl": "^4.14.6",
    "pg": "^8.13.0",
    "serverless-http": "^4.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.5.4"
  }
}
